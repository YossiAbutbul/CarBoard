# Leave empty to run in local mode (data stays in this browser).
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (optional until enforced): a reCAPTCHA key from Google Cloud → Security → reCAPTCHA (score-based, web)
VITE_RECAPTCHA_ENTERPRISE_KEY=
# localhost only: a debug token registered in Firebase → App Check → Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
